PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/lifeadmin_ai
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_web_client_id_here
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000
AI_DOCUMENT_DIRECT_CHAR_LIMIT=10000
AI_DOCUMENT_CHUNK_SIZE=8000
AI_DOCUMENT_CHUNK_OVERLAP=400
AI_MAX_DOCUMENT_CHUNKS=12
AI_MAX_ANALYSIS_CHARS=90000
AI_CHAT_MAX_CONTEXT_CHARS=18000
AI_CHAT_MAX_CHUNKS=4
AI_CHAT_CHUNK_SIZE=4200
AI_CHAT_CHUNK_OVERLAP=250
AI_CHAT_MAX_QUESTION_LENGTH=3000
AI_CHAT_MAX_HISTORY_MESSAGES=8

# Knowledge indexing shares AI_CHAT_CHUNK_SIZE and AI_CHAT_CHUNK_OVERLAP.
# Chunk size is capped below AI_CHAT_MAX_CONTEXT_CHARS; context is capped at 64000.
# Embeddings are disabled by default; text retrieval needs no additional API keys.

# Proactive in-app notifications (worker starts with the API process)
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_INTERVAL_MS=60000
